# AI provider/model pool
# The router tries models in order and temporarily cools down a model after
# 429/5xx/network failures. Do not hard-code a single model in application code.

# Primary provider: Groq
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Backward-compatible alternative: GROQ_MODEL=<one-model>
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=45

# Optional second provider. Its model pool is also rotated automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
# Backward-compatible alternative: OPENROUTER_MODEL=<one-model>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=45
