# Optional bootstrap AI providers. Runtime provider settings can be managed from the dashboard.
# Existing Groq/OpenRouter environment configuration remains supported as a fallback.

GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=45

OPENROUTER_API_KEY=
OPENROUTER_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=45

# Optional Gemini environment fallback.
GEMINI_API_KEY=
GEMINI_MODELS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT=45

# Required when saving provider credentials from the dashboard.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_SETTINGS_ENCRYPTION_KEY=
